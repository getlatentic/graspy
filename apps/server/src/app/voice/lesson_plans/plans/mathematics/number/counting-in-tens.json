  "term": 1,
  "week": 8,
  "objectives": [
    {
      "en": "Count in tens from ten to one hundred and twenty without help.",
      "yo": "Kà ní mẹ́wàá mẹ́wàá láti mẹ́wàá dé ọgọ́fà láìsí ìrànlọ́wọ́.",
      "pcm": "Count for ten ten from ten reach one hundred and twenty without help."
    },
    {
      "en": "Say the next number when you hear a number from the tens.",
      "yo": "Sọ nọ́ńbà tó kàn nígbà tí o bá gbọ́ nọ́ńbà kan nínú àwọn mẹ́wàá mẹ́wàá.",
      "pcm": "Talk the next number when you hear one number from the ten ten."
    }
  ],
  "prerequisites": [
    "mathematics.number.counting-in-twos"
  ],
  "curriculum": {
    "source": "ungrounded",
    "strand": "Number and Numeration",
    "objective": "Count in tens",
    "note": "NERDC has tens only as place-value grouping, not as skip counting. Kept as readiness. Schemes name no such topic; week 8 is a readiness slot, not a scheme placement."
  },
