{
  "id": "mathematics.time.months-of-the-year",
  "subject": "mathematics",
  "topic": "time",
  "sequence": 41,
  "title": {
    "en": "The months of the year",
    "yo": "Àwọn oṣù ọdún",
    "pcm": "Months of the year"
  },
  "classes": [
    "primary_3"
  ],
  "term": 3,
  "week": 5,
  "objectives": [
    {
      "en": "Say the twelve months of the year in order from January to December without help.",
      "yo": "Sọ àwọn oṣù méjìlá ọdún ní ètò láti January dé December láìsí ìrànlọ́wọ́.",
      "pcm": "Talk the twelve months of the year for order from January reach December without help."
    },
    {
      "en": "Say which month comes after any month.",
      "yo": "Sọ oṣù tí ó tẹ̀lé oṣù èyíkéyìí.",
      "pcm": "Talk which month dey come after any month."
    }
  ],
  "prerequisites": [
    "mathematics.time.days-of-the-week"
  ],
  "curriculum": {
    "source": "nerdc",
    "strand": "Mensuration and Geometry / Primary Measures / Time",
    "objective": "Read a calendar: the days of the months and the months of the year"
  },
  "events": [
    {
      "id": "attention",
      "event": "gain_attention",
      "say": {
        "en": "January starts the year. May and June may bring rain. December ends a year of twelve months.",
        "pcm": "January dey start the year. May and June fit bring rain. December dey end one year of twelve months.",
        "yo": "January bẹ̀rẹ̀ ọdún. Òjò lè rọ̀ ní May àti June. December parí ọdún kan tí ó ní oṣù méjìlá."
      },
      "show": {
        "en": "January … December",
        "yo": "January … December",
        "pcm": "January … December"
      }
    },
