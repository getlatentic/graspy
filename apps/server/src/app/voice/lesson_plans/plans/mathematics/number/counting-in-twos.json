  "objectives": [
    {
      "en": "Count in twos from two to twenty-four without help.",
      "yo": "Kà ní méjì méjì láti méjì dé mẹ́rìnlélógún láìsí ìrànlọ́wọ́.",
      "pcm": "Count for two two from two reach twenty-four without help."
    },
    {
      "en": "Say the next number when you hear a number from the twos.",
      "yo": "Sọ nọ́ńbà tó kàn nígbà tí o bá gbọ́ nọ́ńbà kan nínú àwọn méjì méjì.",
      "pcm": "Talk the next number when you hear one number from the two two."
    }
  ],
