  "term": 3,
  "week": 3,
  "objectives": [
    {
      "en": "Say the seven days of the week in order from Monday to Sunday without help.",
      "yo": "Sọ àwọn ọjọ́ méje ọ̀sẹ̀ ní ètò láti Monday dé Sunday láìsí ìrànlọ́wọ́.",
      "pcm": "Talk the seven days of the week for order from Monday reach Sunday without help."
    },
    {
      "en": "Say which day comes after any day.",
      "yo": "Sọ ọjọ́ tí ó tẹ̀lé ọjọ́ èyíkéyìí.",
      "pcm": "Talk which day dey come after any day."
    }
  ],
  "prerequisites": [],
  "curriculum": {
