  "week": 3,
  "objectives": [
    {
      "en": "Count in fives from five to sixty without help.",
      "yo": "Kà ní márùn-ún márùn-ún láti márùn-ún dé ọgọ́ta láìsí ìrànlọ́wọ́.",
      "pcm": "Count for five five from five reach sixty without help."
    },
    {
      "en": "Say the next number when you hear a number from the fives.",
      "yo": "Sọ nọ́ńbà tó kàn nígbà tí o bá gbọ́ nọ́ńbà kan nínú àwọn márùn-ún márùn-ún.",
      "pcm": "Talk the next number when you hear one number from the five five."
    }
  ],
  "prerequisites": [
    "mathematics.number.counting-in-tens"
  ],
