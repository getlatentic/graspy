# For uvicorn (`uv run serve`). The Worker reads wrangler.jsonc, secrets and .dev.vars.
# Each variable is described in docs/DEVELOPMENT.md.

APP_ENV=development
# The web app calls port 8081 in development.
PORT=8081
UVICORN_RELOAD=true

PUBLIC_BASE_URL=http://localhost:8081
A2A_PATH_PREFIX=/a2a
# Blank allows the local dev servers. "*" is refused.
CORS_ORIGINS=

# bedrock (default) or workers-ai; each serves its own gpt-oss-120b.
LLM_HOST=bedrock
AWS_REGION=us-east-1
# Required for bedrock: a Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=
# Required for workers-ai: the account and an API token with Workers AI access.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# Optional: the Firebase project's web API key. Unset turns sign-in off.
# On the Worker it is a secret: npx wrangler secret put FIREBASE_API_KEY
# FIREBASE_API_KEY=

# Required in production (openssl rand -hex 32). Without it, development tokens end at restart.
# SESSION_SECRET=
