# For uvicorn (`uv run serve`). The Worker reads wrangler.jsonc, secrets and .dev.vars.
# Each variable is described in docs/DEVELOPMENT.md.

APP_ENV=development
# The web app calls port 8081 in development.
PORT=8081
UVICORN_RELOAD=true

PUBLIC_BASE_URL=http://localhost:8081
A2A_PATH_PREFIX=/a2a
# Blank allows the local dev servers. "*" is refused.
CORS_ORIGINS=

# Optional: a named model (gpt-oss-120b, gemma-4-31b, gpt-oss-120b-workers-ai) from
# src/app/llm/profiles.py. LLM_HOST, LLM_MODEL_ID and LLM_BASE_URL below win over it.
# LLM_PROFILE=
# bedrock (default) or workers-ai; each serves its own gpt-oss-120b.
LLM_HOST=bedrock
# Optional: the host's base URL, e.g. https://bedrock-mantle.us-east-1.api.aws/openai/v1
# for models served on that path. Unset uses the host's own URL.
# LLM_BASE_URL=
# true: the tutor's tools travel as native tool calls, not as text in the prompt.
LLM_NATIVE_TOOLS=false
AWS_REGION=us-east-1
# Required for bedrock: a Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=
# Required for workers-ai: the account and an API token with Workers AI access.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=

# The Firebase project's web API key. Unset turns sign-in off.
# On the Worker it is a secret: npx wrangler secret put FIREBASE_API_KEY
# Locally, sign-in goes to Firebase's Auth emulator (see docs/DEVELOPMENT.md),
# which takes any key and vouches for any sign-in. Never set it in production.
FIREBASE_API_KEY=demo-graspy-key
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Required in production (openssl rand -hex 32). Without it, development tokens end at restart.
# SESSION_SECRET=
