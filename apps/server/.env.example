# For uvicorn (`uv run serve`). The Worker reads wrangler.jsonc, secrets and .dev.vars.
# Each variable is described in docs/DEVELOPMENT.md.

APP_ENV=development
# The web app calls port 8081 in development.
PORT=8081
UVICORN_RELOAD=true

PUBLIC_BASE_URL=http://localhost:8081
A2A_PATH_PREFIX=/a2a
# Blank allows the local dev servers. "*" is refused.
CORS_ORIGINS=

LLM_MODEL_ID=openai.gpt-oss-120b
AWS_REGION=us-east-1
# Required: a Bedrock API key.
AWS_BEARER_TOKEN_BEDROCK=

# Required in production (openssl rand -hex 32). Without it, development tokens end at restart.
# SESSION_SECRET=
