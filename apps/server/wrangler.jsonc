{
  "name": "graspy-web-api",
  "main": "src/worker.py",
  // On or after 2026-09-08 selects the Python 3.14 runtime, the first whose
  // pydantic (2.12) the dependencies accept. Keep it at or before the newest
  // date the local workerd knows, or `pywrangler dev` refuses to start.
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "routes": [
    { "pattern": "graspy-api.getlatentic.com", "custom_domain": true },
    { "pattern": "graspy-api.tosinamuda.com", "custom_domain": true }
  ],
  "observability": { "enabled": true },

  // Every 15 minutes: deletes the recordings due for it, those kept with a
  // parent's consent past their time and those never settled after a day
  // (app/voice/recording_retention.py).
  "triggers": { "crons": ["*/15 * * * *"] },

  // The MCP Apps views, built from ./ui (npm --prefix ui run build). The Worker
  // reads each document through ASSETS; its scripts, styles and fonts are
  // served straight from the assets, before the Worker runs.
  "assets": { "directory": "./assets", "binding": "ASSETS" },

  // The school-system catalogue is read from files beside its module; JSON
  // is not uploaded by default.
  "rules": [
    {
      "type": "Text",
      "globs": ["app/education/data/**/*.json"],
      "fallthrough": true
    }
  ],

  // What the Worker never loads (UNUSED_PACKAGES in src/worker.py), left out
  // of the upload, which counts toward the startup snapshot's size cap.
  "python_modules": {
    "exclude": [
      "**/*.pyc",
      "**/*.pyi",
      "gepa/**",
      "tqdm/**",
      "requests/**",
      "urllib3/**",
      "charset_normalizer/**",
      "pydantic/v1/**",
      "dspy/evaluate/**",
      "dspy/datasets/**",
      "dspy/propose/**"
    ]
  },

  "vars": {
    "APP_ENV": "production",
    "LLM_HOST": "bedrock",
    // Who hears English: "whisper" or "nova" (Deepgram Nova-3), both on Workers AI, with Intron asked when
    // it cannot answer or hears nothing; or "intron" alone. Nova-3 is on in staging first.
    "ENGLISH_ASR": "whisper",
    "AWS_REGION": "us-east-1",
    "PUBLIC_BASE_URL": "https://graspy-api.getlatentic.com",
    "A2A_PATH_PREFIX": "/a2a",
    "CORS_ORIGINS": "https://graspy.getlatentic.com,https://graspy.tosinamuda.com,https://graspy.pages.dev,https://*.graspy.pages.dev"
  },
  // Secrets, set with `npx wrangler secret put <NAME>`, never in this file:
  //   AWS_BEARER_TOKEN_BEDROCK, SESSION_SECRET, FIREBASE_API_KEY
  //   INTRON_API_KEY (hears the learner) and SPITCH_API_KEY (the teacher's
  //   voice), for voice lessons

  "durable_objects": {
    "bindings": [
      { "name": "CONVERSATIONS", "class_name": "Conversation" },
      { "name": "LESSONS", "class_name": "Lesson" },
      { "name": "LEARNERS", "class_name": "Learner" },
      { "name": "LESSON_MAKERS", "class_name": "LessonMaker" }
    ]
  },
  // Voice lessons: recordings and marked turns, the steps each learner was
  // offered and heard (D1, keyed by learner), recordings and the teacher's
  // voice (R2), the tutor Worker that marks answers and remembers them, and
  // Workers AI for language detection and the teacher's choice of step.
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "graspy",
      "database_id": "6a8a185b-a967-4f1b-889d-1e5f73d2cc93",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "graspy-audio" }],
  "services": [{ "binding": "TUTOR", "service": "graspy-tutor" }],

  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Conversation"] },
    { "tag": "v2", "new_sqlite_classes": ["Lesson"] },
    { "tag": "v3", "new_sqlite_classes": ["Learner", "LessonMaker"] }
  ],

  // Requests per minute per client, counted per Cloudflare location.
  "ratelimits": [
    { "name": "SESSION_LIMITER", "namespace_id": "4101", "simple": { "limit": 20, "period": 60 } },
    { "name": "GENERATE_LIMITER", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "AGENT_LIMITER", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_LIMITER", "namespace_id": "4104", "simple": { "limit": 120, "period": 60 } }
  ],

  // Staging: its own Worker (graspy-web-api-staging), database, bucket, tutor,
  // rate-limit counters and secrets, so a change is tried here before production.
  // Deploy with scripts/deploy.sh staging (docs/DEPLOYING.md). Bindings, routes
  // and vars are not inherited from the top level, so each is repeated here;
  // main, compatibility, assets, rules, python_modules, observability and the
  // Durable Object migrations are inherited. pywrangler reads the Python version
  // from the top-level compatibility settings only, so never override them here.
  "env": {
    "staging": {
      "routes": [{ "pattern": "graspy-api-staging.getlatentic.com", "custom_domain": true }],
      "vars": {
        "APP_ENV": "staging",
        "LLM_HOST": "bedrock",
        "ENGLISH_ASR": "nova",
        "AWS_REGION": "us-east-1",
        "PUBLIC_BASE_URL": "https://graspy-api-staging.getlatentic.com",
        "A2A_PATH_PREFIX": "/a2a",
        "CORS_ORIGINS": "https://graspy-staging.getlatentic.com"
      },
      "durable_objects": {
        "bindings": [
          { "name": "CONVERSATIONS", "class_name": "Conversation" },
          { "name": "LESSONS", "class_name": "Lesson" },
          { "name": "LEARNERS", "class_name": "Learner" },
          { "name": "LESSON_MAKERS", "class_name": "LessonMaker" }
        ]
      },
      "triggers": { "crons": ["*/15 * * * *"] },
      "ai": { "binding": "AI" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "graspy-staging",
          "database_id": "07fc359e-dfd1-40f8-b656-3d2aa1f74673",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "AUDIO", "bucket_name": "graspy-audio-staging" }],
      "services": [{ "binding": "TUTOR", "service": "graspy-tutor-staging" }],
      "ratelimits": [
        { "name": "SESSION_LIMITER", "namespace_id": "4201", "simple": { "limit": 20, "period": 60 } },
        { "name": "GENERATE_LIMITER", "namespace_id": "4202", "simple": { "limit": 30, "period": 60 } },
        { "name": "AGENT_LIMITER", "namespace_id": "4203", "simple": { "limit": 30, "period": 60 } },
        { "name": "API_LIMITER", "namespace_id": "4204", "simple": { "limit": 120, "period": 60 } }
      ]
    }
  }
}
