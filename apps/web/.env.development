# Public: Vite writes these into the bundle. Override locally in .env.local.
VITE_API_URL=http://localhost:8081/api
VITE_A2A_BASE=http://localhost:8081/a2a
# Sign-in goes to Firebase's Auth emulator (docs/DEVELOPMENT.md): a demo project,
# which no real account can reach.
VITE_FIREBASE_API_KEY=demo-graspy-key
VITE_FIREBASE_AUTH_DOMAIN=demo-graspy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-graspy
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
