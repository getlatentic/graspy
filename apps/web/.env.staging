# Public: Vite writes these into the bundle. Never put a secret here.
# Cloudflare's published test site key, which passes every visitor: staging has no bot check
# until its own Turnstile widget is made and this key replaced (docs/DEPLOYING.md). Production
# refuses this key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_API_URL=https://graspy-api-staging.getlatentic.com/api
VITE_A2A_BASE=https://graspy-api-staging.getlatentic.com/a2a
