// Staging's web app: a Worker serving the build as static assets, which reads
// dist/_headers as Pages does. Production stays on the Pages project `graspy`
// (wrangler pages deploy), so this file is named for staging and never read
// by default. Deploy with scripts/deploy.sh staging (docs/DEPLOYING.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "graspy-staging",
  "compatibility_date": "2026-09-21",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "graspy-staging.getlatentic.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // Every app route is index.html, as on Pages when there is no 404.html.
    "not_found_handling": "single-page-application"
  }
}
