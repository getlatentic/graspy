{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "graspy teacher",
  "version": "0.1.0",
  "identifier": "ai.graspy.teacher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "graspy",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 640,
        "backgroundColor": "#f8fbfe"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/content/**/*",
      "binaries/licenses/*"
    ],
    "externalBin": [
      "binaries/graspy-inference-runner",
      "binaries/llama-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
