{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "graspy-tutor",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-05",
  "compatibility_flags": ["nodejs_compat"],
  // Reached only through the API Worker's service binding: a public address would let anyone
  // write to any learner's memory and spend the account's model budget.
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "ai": { "binding": "AI" },
  // workers-ai or bedrock (with google.gemma-4-e2b, or SPELLER_MODEL). Bedrock also needs the secret
  // AWS_BEARER_TOKEN_BEDROCK. Staging runs Bedrock; production stays on Workers AI until it is moved on purpose.
  "vars": { "SPELLER_HOST": "workers-ai" },
  "durable_objects": {
    "bindings": [{ "name": "Learner", "class_name": "Learner" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Learner"] }],

  // Staging: graspy-tutor-staging, reached only by graspy-web-api-staging. Bindings are
  // not inherited from the top level; the Durable Object migrations are.
  "env": {
    "staging": {
      "ai": { "binding": "AI" },
      "vars": { "SPELLER_HOST": "bedrock" },
      "durable_objects": {
        "bindings": [{ "name": "Learner", "class_name": "Learner" }]
      }
    }
  }
}
