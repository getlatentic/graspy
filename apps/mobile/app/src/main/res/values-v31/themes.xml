<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 and later draw the splash themselves: the sprout alone on the surface, with no disc. -->
    <style name="Theme.Graspy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/graspy_blue</item>
        <item name="android:navigationBarColor">@color/graspy_surface</item>
        <item name="android:statusBarColor">@color/graspy_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/graspy_surface</item>
        <item name="android:windowSplashScreenBackground">@color/graspy_surface</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/graspy_surface</item>
    </style>
</resources>
