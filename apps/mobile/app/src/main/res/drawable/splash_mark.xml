<?xml version="1.0" encoding="utf-8"?>
<!--
  The sprout for the splash screen: graspy blue on the surface, with no disc. The splash icon is 240dp,
  above lint's 200dp advice, with the 24dp sprout drawn at 132dp in the middle. Without a disc the
  platform shows the icon at 288dp inside a 192dp mask, so the sprout appears at 158dp and its furthest
  point 75dp from the centre, inside the mask. The sign-in screen draws it at that size and place.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:width="240dp"
    android:height="240dp"
    android:viewportWidth="240"
    android:viewportHeight="240"
    tools:ignore="VectorRaster">
    <group
        android:scaleX="5.5"
        android:scaleY="5.5"
        android:translateX="54"
        android:translateY="54">
        <path
            android:pathData="M12,22V12"
            android:strokeColor="@color/graspy_blue"
            android:strokeWidth="2"
            android:strokeLineCap="round" />
        <path
            android:pathData="M12,14C12,9 8,5.7 3.4,6.3C3.4,11.3 7,14.5 12,14Z"
            android:fillColor="@color/graspy_blue" />
        <path
            android:pathData="M12,12C12,7.3 15.6,4.1 20.6,4.7C20.6,9.7 16.6,12.7 12,12Z"
            android:fillColor="@color/graspy_blue" />
    </group>
</vector>
